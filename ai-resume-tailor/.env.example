# REQUIRED for AI features (reading resumes into sections, tailoring, regenerating sections).
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# Public address of the site (used in password-reset links). Example: https://resume.example.com
# BASE_URL=http://localhost:3000
# AI_REQUESTS_PER_HOUR=40

# Optional: email for "Forgot password" links. Without these, reset links are printed in the server log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AI Resume Tailor <no-reply@example.com>"

# Set when deploying behind HTTPS
# NODE_ENV=production
# TRUST_PROXY=1
